# ─── OrçaVidro Pro · Bot WhatsApp · Variáveis de ambiente ───────────────────
# Copie para `.env` (nunca commite o .env!):
#   cp .env.example .env
#
# No Render: configure em Dashboard → serviço → Environment.

# Token de verificação do webhook (você escolhe, ex.: "meu-token-secreto-123")
# A Meta envia esse valor ao configurar o webhook.
VERIFY_TOKEN=

# Token permanente da API do WhatsApp Cloud (Meta → WhatsApp Manager → API Setup)
WHATSAPP_TOKEN=

# ID do número de telefone no WhatsApp Cloud API (só números)
PHONE_NUMBER_ID=

# Segredo do app Meta (para verificar assinatura X-Hub-Signature-256 do webhook)
# Meta → App → Configurações → Básico → Segredo do app
APP_SECRET=

# Token simples para proteger GET /leads (só o Tito usa — escolha uma senha forte)
# Envie como header `x-admin-token` ao consultar.
ADMIN_TOKEN=

# Porta do servidor (Render define automaticamente; padrão local: 3001)
PORT=3001
